<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Backend base URL. Replace with your deployed Render URL before release,
	     e.g. https://mealio-backend.onrender.com -->
	<key>API_BASE_URL</key>
	<string>https://mealio-backend-d7aa.onrender.com</string>
	<!-- Shared secret. Must match the backend's APP_API_KEY env var.
	     Injected at build time from Secrets.xcconfig (gitignored). Undefined →
	     empty → auth disabled (dev). See Secrets.xcconfig.example. -->
	<key>API_KEY</key>
	<string>$(API_KEY)</string>
</dict>
</plist>
