<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Backend base URL. Replace with your deployed Render URL before release,
	     e.g. https://mealio-backend.onrender.com -->
	<key>API_BASE_URL</key>
	<string>https://mealio-backend-17qg.onrender.com</string>
	<!-- Shared secret. Must match the backend's APP_API_KEY env var.
	     Leave empty to disable auth (dev only). For production, inject this at
	     build time via a gitignored xcconfig rather than committing it. -->
	<key>API_KEY</key>
	<string></string>
</dict>
</plist>
