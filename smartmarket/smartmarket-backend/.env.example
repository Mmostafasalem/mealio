# Copy this file to .env and fill in real values before starting the server.
# Never commit .env to git.

# Required: Groq API key for AI meal plan generation
GROQ_API_KEY=gsk_your_groq_key_here

# Recommended: Shared secret between iOS app and backend.
# Set this to a random string (e.g. openssl rand -hex 32).
# The iOS app must send this in the X-API-Key header on every request.
# Leave blank to disable auth (dev only).
APP_API_KEY=your_random_secret_here

# Optional: Groq model id (default: llama-3.3-70b-versatile).
# Swap models without a code change, e.g. llama-3.1-8b-instant for cheaper/faster.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: port the server listens on (default 5000)
PORT=5000

# Enable only after verified Apple configuration and durable storage are ready.
AI_ACCOUNTS_ENABLED=0
AI_STATE_PERSISTENT=0
AI_STATE_DB=/var/data/mealio-ai.sqlite
AI_DAILY_CREDITS=30
AI_GLOBAL_DAILY_ATTEMPTS=900
APPLE_APP_ID=com.mostafa.mealio
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AI_SUBJECT_SECRET=
AI_TOKEN_ENCRYPTION_KEY=
