# Copy this file to .env and fill in real values before starting the server.
# Never commit .env to git.

# Groq API key: required only when AI_ACCOUNTS_ENABLED=1 (online AI)
GROQ_API_KEY=gsk_your_groq_key_here

# Recommended: Shared secret between iOS app and backend.
# Set this to a random string (e.g. openssl rand -hex 32).
# The iOS app must send this in the X-API-Key header on every request.
# Leave blank to disable auth (dev only).
APP_API_KEY=your_random_secret_here

# Optional: Groq model id (default: openai/gpt-oss-120b).
# Swap models without a code change, e.g. openai/gpt-oss-20b for cheaper/faster.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: port the server listens on (default 5000)
PORT=5000

# How many reverse proxies sit in front of the app (Render: 1, to be confirmed
# once against a real request, see DEPLOY.md). Required when MEALIO_ENV=production;
# local development falls back to 1.
TRUSTED_PROXY_COUNT=1

# Leave unset. Set to 1 only to bring back the retired AI routes
# (/api/meal-plan, /api/gap-fillers, /api/shopping-advice, /api/workout),
# which otherwise answer 410 Gone. The app builds all of these on the phone.
# LEGACY_AI_ROUTES=0

# Enable only after verified Apple configuration and durable storage are ready.
AI_ACCOUNTS_ENABLED=0
AI_STATE_PERSISTENT=0
AI_STATE_DB=/var/data/mealio-ai.sqlite
AI_DAILY_CREDITS=15
AI_GLOBAL_DAILY_ATTEMPTS=900
# Guest access (off unless 1). Guests share a smaller daily pool inside the
# ceiling above; default is a quarter of it (225 when the ceiling is 900).
AI_GUEST_ENABLED=0
# AI_GUEST_GLOBAL_DAILY_ATTEMPTS=225
APPLE_APP_ID=com.mostafa.mealio
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
AI_SUBJECT_SECRET=
AI_TOKEN_ENCRYPTION_KEY=
