# Mealio web — copy to .env.local and fill in. Both are SERVER-side only
# (used by the /api/backend proxy); neither is exposed to the browser.

# Flask backend the proxy forwards to.
BACKEND_URL=https://mealio-backend-17qg.onrender.com

# Shared secret sent as X-API-Key. Must match APP_API_KEY set on the backend
# (Render). Leave blank while backend auth is disabled.
APP_API_KEY=
